{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unciv-rust-web.invalid/schemas/scenario.schema.json",
  "title": "Cross-engine scenario",
  "type": "object",
  "required": ["schemaVersion", "name", "seed", "instructions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer" },
    "instructions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "payload": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
